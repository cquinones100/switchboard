#!/usr/bin/env node

// apply-actions <repo> <from> <to>
//
// What a change needs to take effect on this Mac, once it is checked out in
// <repo>: the range <from>..<to> is what the clone just moved by. One action
// per line, tab-separated:
//
//   <key>  <label>  <why>  <command>
//
// The command is a shell command to run as it is; an empty one is something
// only you can do (reload Ghostty's config, reopen a Neovim), said rather than
// offered. Each action is listed once, however many files call for it, and
// nothing at all when the change needs nothing.
//
// In Switchboard (~/switchboard, by its real path), its own list:
// the sidebar daemon, tmux.conf, the Slack relay while it runs, M-d's diff and
// the Notes app while one is open, Ghostty's config, and any setup part
// `setup.sh --check` has left to do whose files the change touched. In any
// repository, the entry for its origin's owner/name in
// ~/.config/switchboard/repos.json may give an `apply` list of
// { "paths": [<glob>…], "label": …, "command": … }, run in the clone; without
// one, a changed lockfile (an install with the package manager it names,
// where packages are installed), new migration files (the package's migrate
// script, where it has one) and a changed .env.example.
//
// queue-and-clean runs it after a landing and offers what it lists.

const { execFileSync } = require("node:child_process");
const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");

const [repoArg, from, to] = process.argv.slice(2);
if (!repoArg || !from || !to) {
  process.stderr.write("usage: apply-actions <repo> <from> <to>\n");
  process.exit(2);
}
const repo = path.resolve(repoArg);

const git = (...args) => execFileSync("git", ["-C", repo, ...args], { encoding: "utf8", stdio: ["ignore", "pipe", "ignore"] });
const lines = (text) => text.split("\n").filter(Boolean);
const changed = lines(git("diff", "--name-only", from, to));
const added = lines(git("diff", "--name-only", "--diff-filter=A", from, to));
const quote = (text) => `'${text.replaceAll("'", `'\\''`)}'`;
const why = (files) => `${files[0]}${files.length > 1 ? ` and ${files.length - 1} more` : ""} changed`;

const actions = [];
const add = (key, label, files, command = "") => {
  if (files.length && !actions.some((action) => action.key === key)) actions.push({ key, label, why: why(files), command });
};
const touching = (...patterns) => changed.filter((file) => patterns.some((pattern) => pattern.test(file)));
const mtime = (file) => {
  try {
    return fs.statSync(file).mtimeMs;
  } catch {
    return undefined;
  }
};
const alive = (pidFile) => {
  try {
    process.kill(Number(fs.readFileSync(pidFile, "utf8").split(" ")[0]), 0);
    return true;
  } catch {
    return false;
  }
};
// What the panes of the tmux this runs in hold, read only inside tmux.
const panes = () => {
  if (!process.env.TMUX) return [];
  try {
    return lines(execFileSync("tmux", ["list-panes", "-a", "-F", "#{@in_place}\t#{@notes_pane}"], { encoding: "utf8" })).map((line) => line.split("\t"));
  } catch {
    return [];
  }
};

// ── Switchboard ─────────────────────────────────────────────────────────────

// The files a setup part puts in place, for a part left to do.
const SETUP_PATHS = {
  tmux: /^tmux\//,
  bin: /^bin\//,
  skills: /^claude\/skills\//,
  claude: /^claude\//,
  claude_md: /^claude\/switchboard\.md$/,
  neovim: /^nvim\//,
  ghostty: /^ghostty\//,
  lazygit: /^lazygit\//,
  karabiner: /^karabiner\//,
  pgcli: /^pgcli\//,
  git: /^\.githooks\//,
};

// setup.sh's parts that run without questions, as --check names them.
const PARTS = new Set([...Object.keys(SETUP_PATHS), "autosave", "config", "terminal"]);

const switchboard = () => {
  const apply = "~/.config/tmux/apply.sh";
  const setup = quote(path.join(repo, "setup.sh"));

  // Setup's parts first, since what they install (plugins, packages, links)
  // is what a reload or restart after them should load.
  const setupChanged = changed.includes("setup.sh");
  if (setupChanged || Object.values(SETUP_PATHS).some((pattern) => touching(pattern).length)) {
    let check = "";
    try {
      check = execFileSync(path.join(repo, "setup.sh"), ["--check"], { cwd: repo, encoding: "utf8", stdio: ["ignore", "pipe", "ignore"] });
    } catch (error) {
      // It exits 1 when something is left to do.
      check = error.stdout ?? "";
    }
    // Only what is left to do, never the optional parts it suggests.
    const heading = check.indexOf("Left to do:");
    const left = heading === -1 ? "" : check.slice(heading);
    const anySetup = setupChanged ? ["setup.sh"] : Object.values(SETUP_PATHS).flatMap((pattern) => touching(pattern));
    for (const line of left.split("\n").filter((text) => text.includes("✗"))) {
      // One line may name several parts (./setup.sh tmux neovim bin), and
      // the words after them are prose.
      const words = line.match(/\.\/setup\.sh((?: [\w-]+)+)/)?.[1].trim().split(" ") ?? [];
      const parts = [];
      for (const word of words) {
        if (!PARTS.has(word)) break;
        parts.push(word);
      }
      for (const part of parts) {
        add(`setup-${part}`, `Run setup's ${part} part`, setupChanged ? ["setup.sh"] : touching(SETUP_PATHS[part] ?? /$^/), `${setup} ${part}`);
      }
      // What only the guided setup does (merging changed Claude Code settings
      // into yours, which asks first), or a need it can't meet itself, such as
      // a tool to install, counted only when setup.sh changed, since one left
      // from before is no news.
      if (!parts.length && (words.length || setupChanged)) add("setup-guided", `Run the guided setup, ./setup.sh (${line.replace(/^\s*✗\s*/, "")})`, anySetup);
    }
  }
  // lib's packages, before anything that loads them restarts: the post-merge
  // hook's setup is only where setup.sh git has set this clone's hooks, and
  // installs only when a direct dependency's version changed.
  add("install:lib", "Install lib's packages (npm ci)", touching(/^lib\/package(-lock)?\.json$/), `cd ${quote(path.join(repo, "lib"))} && npm ci`);

  // The daemon's code, the modules it requires from lib/, and the settings'
  // list, which it reads once.
  // Unless it started after the change was on disk: setup's tmux part, which
  // the post-merge hook runs, restarts a daemon older than lib/'s code; a
  // deleted file, which that check never sees, always asks.
  const daemonFiles = touching(/^tmux\/settings\.json$/, /^lib\/sidebar\//, /^lib\/slack-relay\//, /^lib\/(connector|presence|requests|settings)\.js$/, /^lib\/package(-lock)?\.json$/, /^bin\/tmux-sidebar$/);
  const started = mtime(path.join(os.homedir(), ".local/state/tmux-sidebar/daemon.pid"));
  const restarted = started && alive(path.join(os.homedir(), ".local/state/tmux-sidebar/daemon.pid")) && daemonFiles.every((file) => (mtime(path.join(repo, file)) ?? Infinity) < started);
  // An install listed above runs after it started, so it restarts after that.
  if (!restarted || actions.some((action) => action.key === "install:lib")) add("sidebar", "Restart the sidebar daemon", daemonFiles, `${apply} sidebar`);
  // What tmux.conf reads or runs as it loads: the scripts its own lines run
  // (unindented, so not a binding's or a hook's), and what those run in turn.
  let conf = "";
  try {
    conf = fs.readFileSync(path.join(repo, "tmux/tmux.conf"), "utf8");
  } catch {}
  const atLoad = new Set(["tmux.conf", "settings.json", "plugins.txt", "theme.sh", "update-colors.sh"]);
  for (const line of conf.split("\n").filter((text) => /^(run-shell|run|if-shell)\b/.test(text))) {
    for (const [, script] of line.matchAll(/~\/\.config\/tmux\/([\w.-]+)/g)) atLoad.add(script);
  }
  add("reload", "Reload tmux.conf", changed.filter((file) => file.startsWith("tmux/") && atLoad.has(file.slice(5))), `${apply} reload`);
  if (alive(path.join(os.homedir(), ".local/state/slack-relay/relay.lock"))) {
    add("relay", "Restart the Slack relay", touching(/^lib\/slack-relay\//, /^bin\/slack-relay$/, /^lib\/(connector|presence|requests|settings)\.js$/), `${apply} relay`);
  }
  add("panes", "Restart the sidebar panes, which run sidebar-pane.zsh for as long as they are open", touching(/^tmux\/sidebar-pane\.zsh$/), `${apply} panes`);
  // The plugins at the lockfile's commits, before anything reopens them.
  add("lazy", "Restore Neovim's plugins to the lockfile (:Lazy restore)", touching(/^nvim\/lazy-lock\.json$/), "nvim --headless '+Lazy! restore' +qa");
  const open = panes();
  if (open.some(([tool]) => tool === "diffview")) add("diff", "Reopen M-d's diff, since an open one runs the old code", touching(/^nvim\//));
  if (open.some(([, notes]) => notes === "1")) add("notes", "Reopen the Notes app, since it runs the old code", touching(/^notes\//, /^nvim\//));
  add("ghostty", "Reload Ghostty's config (Cmd-Shift-,)", touching(/^ghostty\//));
};

// ── Any repository ──────────────────────────────────────────────────────────

const globRegex = (glob) =>
  new RegExp(
    `^${glob
      .replace(/[.+^${}()|[\]\\]/g, "\\$&")
      // **/ is any number of whole folders, a ** left at the end anything.
      .replace(/\*\*\//g, "\u0000")
      .replace(/\*\*/g, "\u0001")
      .replace(/\*/g, "[^/]*")
      .replace(/\?/g, "[^/]")
      .replaceAll("\u0000", "(?:.*/)?")
      .replaceAll("\u0001", ".*")}$`,
  );

const entry = () => {
  try {
    const url = git("remote", "get-url", "origin").trim();
    const name = url.replace(/\.git$/, "").match(/[:/]([^/:]+\/[^/]+)$/)?.[1];
    const repos = JSON.parse(fs.readFileSync(path.join(os.homedir(), ".config/switchboard/repos.json"), "utf8"));
    return name ? repos[name] : undefined;
  } catch {
    return undefined;
  }
};

const LOCKFILES = {
  "pnpm-lock.yaml": ["pnpm", "pnpm install --frozen-lockfile"],
  "package-lock.json": ["npm", "npm ci"],
  "yarn.lock": ["yarn", "yarn install --frozen-lockfile"],
  "bun.lock": ["bun", "bun install --frozen-lockfile"],
  "bun.lockb": ["bun", "bun install --frozen-lockfile"],
  "Gemfile.lock": ["Bundler", "bundle install"],
  "poetry.lock": ["Poetry", "poetry install"],
  "uv.lock": ["uv", "uv sync --frozen"],
};
const JS_LOCKFILES = new Set(["pnpm", "npm", "yarn", "bun"]);
const managerIn = (dir) => {
  for (const [file, [manager]] of Object.entries(LOCKFILES)) {
    if (JS_LOCKFILES.has(manager) && fs.existsSync(path.join(dir, file))) return manager;
  }
  return undefined;
};
const readJson = (file) => {
  try {
    return JSON.parse(fs.readFileSync(file, "utf8"));
  } catch {
    return undefined;
  }
};
const inDir = (dir) => (dir === "." ? "" : ` in ${dir}`);

// Whether you have trusted the clone, as every script here that would run a
// repository's code checks: its real path equal to a line's in
// ~/.config/switchboard/trusted-dirs. An install or migrate script is the
// repository's code, so in a clone not trusted it is named for you to run.
const trusted = () => {
  let text = "";
  try {
    text = fs.readFileSync(path.join(os.homedir(), ".config/switchboard/trusted-dirs"), "utf8");
  } catch {
    return false;
  }
  const real = realpath(repo);
  return text
    .split("\n")
    .map((line) => line.trim())
    .filter((line) => line && !line.startsWith("#"))
    .some((line) => realpath(line.startsWith("~/") ? path.join(os.homedir(), line.slice(2)) : line) === real);
};

const defaults = () => {
  const runs = isSwitchboard || trusted();
  const untrusted = runs ? "" : " yourself (the clone isn't in trusted-dirs)";
  for (const file of changed) {
    const known = LOCKFILES[path.basename(file)];
    if (!known) continue;
    const [manager, command] = known;
    const dir = path.dirname(file);
    // Nothing installed there means nothing out of date (Switchboard's lib/
    // is listed above).
    // (Yarn's Plug'n'Play installs into .pnp.cjs rather than node_modules.)
    if (JS_LOCKFILES.has(manager) && !["node_modules", ".pnp.cjs", ".pnp.js"].some((installed) => fs.existsSync(path.join(repo, dir, installed)))) continue;
    if (isSwitchboard && dir === "lib") continue;
    add(`install:${dir}`, `Install packages with ${manager}${inDir(dir)}${untrusted}`, [file], runs ? `cd ${quote(path.join(repo, dir))} && ${command}` : "");
  }

  const migrations = added.filter((file) => /(^|\/)(migrations?|migrate)\//.test(file));
  for (const file of migrations) {
    // The nearest package.json above it with a migrate script.
    let dir = path.dirname(file);
    let script;
    for (;;) {
      const scripts = readJson(path.join(repo, dir, "package.json"))?.scripts ?? {};
      script = ["db:migrate", "migrate", "migrate:latest", "migrate:up", "db:migrate:dev", "migrate:dev"].find((name) => scripts[name]);
      if (script || dir === ".") break;
      dir = path.dirname(dir);
    }
    if (script) {
      const manager = managerIn(path.join(repo, dir)) ?? managerIn(repo) ?? "npm";
      add(`migrate:${dir}`, `Run the new migrations (${manager} run ${script}${inDir(dir)})${untrusted}`, migrations, runs ? `cd ${quote(path.join(repo, dir))} && ${manager} run ${script}` : "");
    } else {
      add("migrate", "Run the new migrations", migrations);
    }
  }

  add("env", "Copy what's new in .env.example into your .env", changed.filter((file) => /(^|\/)\.env\.(example|sample)$/.test(file)));
};

// Only your own clone, ~/switchboard, by its real path: its setup.sh --check
// runs while the list is worked out, before anything is asked, so another
// repository shaped like it never counts.
const realpath = (dir) => {
  try {
    return fs.realpathSync(dir);
  } catch {
    return undefined;
  }
};
const isSwitchboard = realpath(repo) === realpath(path.join(os.homedir(), "switchboard"));
if (isSwitchboard) switchboard();
const own = entry()?.apply;
if (Array.isArray(own)) {
  for (const { paths = [], label, command = "" } of own) {
    const patterns = paths.map(globRegex);
    // Your command, but it may run the clone's code (make, a package script).
    const runs = command && trusted();
    add(`own:${label}`, runs || !command ? label : `${label} yourself (the clone isn't in trusted-dirs)`, changed.filter((file) => patterns.some((pattern) => pattern.test(file))), runs ? `cd ${quote(repo)} && ${command}` : "");
  }
} else {
  defaults();
}

for (const { key, label, why: reason, command } of actions) process.stdout.write(`${key}\t${label}\t${reason}\t${command}\n`);
