#!/usr/bin/env node

// switchboard-handoff [--state-dir <dir>] [--port <clone>] [--dry-run]
// switchboard-handoff --back [--state-dir <dir>] [--dry-run]
//
// Hands this tmux workspace to the Rust port of Switchboard
// (cooljacob204/switchboard, branch rust-conversion), and brings it back.
//
// The handoff writes the port's <state dir>/layout.json from tmux, in the
// shape its src/mux/persist.rs restores when its server starts with no
// sessions: every session with its tabs, each tab's split tree, options,
// active pane and zoom, and each pane's directory, options, Claude session,
// and with the save_contents setting on its screen and history as text. It
// then copies our state files into the port's state directory (STATE_FILES),
// never moving them, so this workspace keeps working. Nothing is stopped: the
// output ends with the steps to cut over.
//
// --back reads the port's layout.json (layout.json.1 when that is missing)
// and recreates its sessions, tabs, splits and options in tmux, typing
// `claude --resume <id>` into each Claude pane and starting Notes where it ran,
// then copies the state files back, each only where the port's copy is newer.
//
//   --state-dir <dir>  the port's state directory (default
//                      ~/.local/state/switchboard-rs; never ours,
//                      ~/.local/state/switchboard); start the port with
//                      SWITCHBOARD_STATE_DIR=<dir>
//   --port <clone>     the port's clone: each state file is copied only when
//                      its source names it, rather than by STATE_FILES alone
//   --dry-run          print the layout and the files, writing nothing
//
// Both refuse while a port server runs on that state directory (it holds an
// flock on server.lock), since a running server ignores layout.json and writes
// over it.

const { execFileSync, spawnSync } = require("node:child_process");
const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");

const untrusted = require(path.join(__dirname, "../lib/untrusted"));

const HOME = os.homedir();
const tilde = (p) => (p.startsWith(HOME + "/") ? "~" + p.slice(HOME.length) : p);
const SIDEBAR_STATE = path.join(HOME, ".local/state/tmux-sidebar");
const OUR_STATE = path.join(HOME, ".local/state/switchboard");
const DEFAULT_PORT_STATE = path.join(HOME, ".local/state/switchboard-rs");
// The port's file shape (persist.rs's VERSION) and how much history it keeps
// per pane (CONTENT_LINES).
const VERSION = 1;
const CONTENT_LINES = 2000;

// Our state files and the port's name for each, in its one state directory:
// the place to fix a name the port changes. `port: null` is a file the port
// doesn't read, listed as skipped. A directory is copied whole.
const STATE_FILES = [
  { from: SIDEBAR_STATE, name: "autopilot.json", port: "autopilot.json" },
  { from: SIDEBAR_STATE, name: "context", port: "context" },
  { from: SIDEBAR_STATE, name: "usage", port: "usage" },
  { from: SIDEBAR_STATE, name: "habits", port: "habits" },
  { from: SIDEBAR_STATE, name: "suggestions.json", port: "suggestions.json" },
  { from: SIDEBAR_STATE, name: "calendar.json", port: "calendar.json" },
  { from: SIDEBAR_STATE, name: "slack.json", port: "slack.json" },
  { from: SIDEBAR_STATE, name: "calendar-seen.json", port: "calendar-seen.json" },
  { from: SIDEBAR_STATE, name: "new-notes.json", port: "new-notes.json" },
  { from: SIDEBAR_STATE, name: "meetings.json", port: "meetings.json" },
  { from: SIDEBAR_STATE, name: "connectors.json", port: "connectors.json" },
  { from: OUR_STATE, name: "tips", port: "tips" },
  { from: OUR_STATE, name: "requests", port: "requests" },
  { from: OUR_STATE, name: "wtn-claims.tsv", port: null },
];

// The window options a tab carries over: window-options.sh's, the pin, and
// Notes' own tab.
const TAB_OPTIONS = [
  "@tab_name", "@tab_title", "@tab_note", "@tab_note_last", "@tab_note_asked", "@tab_note_arrived",
  "@remind_at", "@remind_note", "@remind_said", "@pinned", "@notes", "@notes_beside",
  "@autopilot", "@autopilot_in", "@autopilot_item", "@autopilot_left", "@autopilot_seen", "@autopilot_note", "@autopilot_land", "@autopilot_autoland",
];
// Pane options left behind: the daemon's and agent-state.sh's, which the port
// works out again, and a tool's marks, since the pane it stands for is the one
// handed off.
const dropPaneOption = (name) => name === "@sidebar" || name.startsWith("@agent_") || name === "@in_place" || name === "@parked_pane";

const fail = (message) => {
  console.error(`switchboard-handoff: ${message}`);
  process.exit(1);
};

const parseArgs = (argv) => {
  const opts = { back: false, dryRun: false, stateDir: DEFAULT_PORT_STATE, port: undefined };
  for (let i = 0; i < argv.length; i++) {
    const arg = argv[i];
    if (arg === "--back") opts.back = true;
    else if (arg === "--dry-run") opts.dryRun = true;
    else if (arg === "--state-dir" || arg === "--port") {
      const value = argv[++i];
      if (!value) fail(`${arg} needs a path`);
      opts[arg === "--port" ? "port" : "stateDir"] = path.resolve(value.replace(/^~(?=\/|$)/, HOME));
    } else if (arg === "-h" || arg === "--help") {
      console.log("usage: switchboard-handoff [--back] [--state-dir <dir>] [--port <clone>] [--dry-run]");
      process.exit(0);
    } else fail(`unknown argument ${arg}`);
  }
  if (opts.back && opts.port) fail("--port is for the handoff");
  return opts;
};

const real = (p) => {
  try {
    return fs.realpathSync(p);
  } catch {
    return path.resolve(p);
  }
};

// ── tmux ─────────────────────────────────────────────────────────────────────

const tmuxEnv = { ...process.env, LC_ALL: "en_US.UTF-8" };
const tmux = (args) => execFileSync("tmux", args, { encoding: "utf8", env: tmuxEnv, maxBuffer: 256 * 1024 * 1024 });
// Several commands in one tmux call, each an array of words.
const tmuxBatch = (commands) => {
  if (!commands.length) return "";
  return tmux(commands.flatMap((command, i) => (i ? [";", ...command] : command)));
};
const fields = (format, line) => {
  const values = line.split("\t");
  return Object.fromEntries(format.map((name, i) => [name, values[i] ?? ""]));
};

// A value as `show-options` prints it: in double quotes when it has spaces,
// with backslash escapes either way.
const unquote = (text) => {
  const body = text.startsWith('"') && text.endsWith('"') && text.length > 1 ? text.slice(1, -1) : text;
  const named = { t: "\t", n: "\n", r: "\r", e: "\x1b" };
  return body.replace(/\\(?:([0-7]{3})|(.))/gs, (_, octal, ch) => (octal ? String.fromCharCode(parseInt(octal, 8)) : named[ch] ?? ch));
};
const parseOptions = (text) =>
  Object.fromEntries(
    text
      .split("\n")
      .filter((line) => line.startsWith("@"))
      .map((line) => {
        const at = line.indexOf(" ");
        return at < 0 ? [line, ""] : [line.slice(0, at), unquote(line.slice(at + 1))];
      }),
  );

// tmux's window_layout as a tree of { w, h, pane } and { w, h, across,
// children }. tmux 3.8 writes it as JSON ({"V":2,"L":…}: "t" "p" a pane, its id
// in "I", "h" children side by side, "v" one above another, in "c"); before,
// `<csum>,WxH,X,Y` then `,<pane>` for a pane, `{…}` for children side by side,
// `[…]` for children one above another.
const parseTmuxLayout = (text) => {
  if (text.startsWith("{")) {
    const node = (n) =>
      n.t === "p"
        ? { w: n.w, h: n.h, pane: Number(String(n.I).replace("%", "")) }
        : { w: n.w, h: n.h, across: n.t === "h", children: n.c.map(node) };
    return node(JSON.parse(text).L);
  }
  let at = text.indexOf(",") + 1;
  const node = () => {
    const head = /^(\d+)x(\d+),(\d+),(\d+)/.exec(text.slice(at));
    if (!head) throw new Error(`can't read the layout ${text}`);
    at += head[0].length;
    const size = { w: Number(head[1]), h: Number(head[2]) };
    const open = text[at];
    if (open === ",") {
      const id = /^,(\d+)/.exec(text.slice(at));
      at += id[0].length;
      return { ...size, pane: Number(id[1]) };
    }
    const close = open === "{" ? "}" : "]";
    at++;
    const children = [node()];
    while (text[at] === ",") {
      at++;
      children.push(node());
    }
    if (text[at] !== close) throw new Error(`can't read the layout ${text}`);
    at++;
    return { ...size, across: open === "{", children };
  };
  return node();
};

// The tree with `keep(pane)` false dropped, each dropped pane's space given to
// its neighbor (the one after it, else the one before), a split of one child
// made that child, in the port's Layout: { Pane: n } or
// { Split: { across, children, shares } }, shares summing to 1.
const toPortLayout = (tree, keep, rename) => {
  const prune = (node) => {
    if (node.pane !== undefined) return keep(node.pane) ? { ...node, pane: rename(node.pane) } : null;
    const sizeOf = (child) => (node.across ? child.w : child.h);
    const kids = [];
    let carry = 0;
    node.children.forEach((child) => {
      const kept = prune(child);
      if (!kept) {
        carry += sizeOf(child);
        return;
      }
      kids.push({ node: kept, size: sizeOf(child) + carry });
      carry = 0;
    });
    if (!kids.length) return null;
    kids.at(-1).size += carry;
    if (kids.length === 1) return kids[0].node;
    const total = kids.reduce((sum, k) => sum + k.size, 0);
    return { across: node.across, children: kids.map((k) => k.node), shares: kids.map((k) => k.size / total) };
  };
  const toPort = (node) =>
    node.pane !== undefined
      ? { Pane: node.pane }
      : { Split: { across: node.across, children: node.children.map(toPort), shares: node.shares } };
  const pruned = prune(tree);
  return pruned && toPort(pruned);
};
const layoutPanes = (layout) => (layout.Pane !== undefined ? [layout.Pane] : layout.Split.children.flatMap(layoutPanes));

// ── Claude sessions ──────────────────────────────────────────────────────────

const alive = (pid) => {
  try {
    process.kill(pid, 0);
    return true;
  } catch (error) {
    return error.code === "EPERM";
  }
};
const safeId = (id) => typeof id === "string" && /^[A-Za-z0-9_-]+$/.test(id);
// The live interactive Claude sessions, from ~/.claude/sessions/<pid>.json. A
// headless one (entrypoint sdk-…, a loop's helper) is never resumed. A
// conversation moved into the background is carried on by a job with no pane,
// whose session file has the parked session's parkedJobId as its jobId, so the
// pane's session is the job's, as lib/sidebar/claude.js's sessionsByPane takes it.
const claudeSessions = () => {
  const dir = path.join(HOME, ".claude/sessions");
  let names = [];
  try {
    names = fs.readdirSync(dir).filter((name) => /^\d+\.json$/.test(name));
  } catch {}
  const all = names.flatMap((name) => {
    const pid = Number(name.slice(0, -5));
    try {
      const session = JSON.parse(fs.readFileSync(path.join(dir, name), "utf8"));
      return alive(pid) && safeId(session.sessionId) ? [{ ...session, pid }] : [];
    } catch {
      return [];
    }
  });
  return all
    .filter((session) => !session.entrypoint?.startsWith("sdk"))
    .map((session) => {
      let current = session;
      const seen = new Set([current.sessionId]);
      while (current.parkedJobId) {
        const job = all.find((other) => other.jobId === current.parkedJobId && !seen.has(other.sessionId));
        if (!job) break;
        seen.add(job.sessionId);
        current = job;
      }
      return { pid: session.pid, sessionId: current.sessionId, pane: /%(\d+)$/.exec(session.tmux ?? "")?.[1] };
    });
};

// ── The port's server ────────────────────────────────────────────────────────

// Whether a port server holds server.lock in `dir`: an flock, which Node can't
// take, so perl tries it without waiting.
const portRunning = (dir) => {
  const lock = path.join(dir, "server.lock");
  if (!fs.existsSync(lock)) return false;
  const result = spawnSync("perl", ["-MFcntl=:flock", "-e", 'open(my $f, "<", $ARGV[0]) or exit 2; exit(flock($f, LOCK_EX | LOCK_NB) ? 0 : 1)', lock]);
  return result.status === 1;
};

const checkStateDir = (dir) => {
  if (real(dir) === real(OUR_STATE)) fail(`${tilde(OUR_STATE)} is this workspace's own state directory; give the port another with --state-dir`);
  if (portRunning(dir)) fail(`a port server is running on ${tilde(dir)}: quit it (switchboard kill-server) first, since it would write over layout.json`);
};

// ── The state files ──────────────────────────────────────────────────────────

// Which files the port's source names, given its clone: every string literal
// in its src/, read once.
const portNames = (clone) => {
  const src = path.join(clone, "src");
  if (!fs.existsSync(src)) fail(`${tilde(src)} isn't there: --port names the port's clone`);
  const text = [];
  const walk = (dir) =>
    fs.readdirSync(dir, { withFileTypes: true }).forEach((entry) => {
      const p = path.join(dir, entry.name);
      if (entry.isDirectory()) walk(p);
      else if (entry.name.endsWith(".rs")) text.push(fs.readFileSync(p, "utf8"));
    });
  walk(src);
  const all = text.join("\n");
  return (name) => all.includes(`"${name}"`);
};

// Each file to copy as { ours, theirs }, and each one skipped with why.
const plan = (stateDir, named) => {
  const copy = [];
  const skipped = [];
  STATE_FILES.forEach((entry) => {
    const ours = path.join(entry.from, entry.name);
    if (!entry.port || (named && !named(entry.port))) skipped.push({ ours, why: "the port doesn't read it" });
    else copy.push({ ours, theirs: path.join(stateDir, entry.port) });
  });
  return { copy, skipped };
};

// The files under a path (itself, for a file), relative to it.
const filesUnder = (root) => {
  let stat;
  try {
    stat = fs.statSync(root);
  } catch {
    return [];
  }
  if (!stat.isDirectory()) return [""];
  return fs.readdirSync(root, { recursive: true }).filter((rel) => fs.statSync(path.join(root, rel)).isFile());
};
const mtime = (file) => {
  try {
    return fs.statSync(file).mtimeMs;
  } catch {
    return -1;
  }
};
// Copies `from` to `to`, file by file, keeping each file's time so the way
// back can tell which side is newer; `onlyNewer` leaves a file whose copy at
// `to` is as new or newer. Returns how many files it copied.
const copyFiles = (from, to, onlyNewer) =>
  filesUnder(from).filter((rel) => {
    const source = path.join(from, rel);
    const target = path.join(to, rel);
    if (onlyNewer && mtime(target) >= mtime(source)) return false;
    fs.mkdirSync(path.dirname(target), { recursive: true });
    fs.copyFileSync(source, target);
    const { atime, mtime: modified } = fs.statSync(source);
    fs.utimesSync(target, atime, modified);
    return true;
  }).length;

// ── The handoff ──────────────────────────────────────────────────────────────

const WINDOW_FORMAT = ["session_id", "window_index", "session_name", "window_id", "window_active", "window_last_flag", "window_width", "window_height", "window_layout", "window_zoomed_flag", "@notices_window", "@pane_parked", "@setting_save_contents", ...TAB_OPTIONS];
const PANE_FORMAT = ["window_id", "pane_id", "pane_active", "pane_last", "pane_current_path", "@sidebar", "@in_place", "@parked_pane", "@notes_pane"];

const snapshot = () => {
  const read = (kind, format) =>
    tmux([kind, "-a", "-F", format.map((name) => `#{${name}}`).join("\t")])
      .split("\n")
      .filter(Boolean)
      .map((line) => fields(format, line));
  // In the order the tab bar shows them, sessions in the order they were made.
  const windows = read("list-windows", WINDOW_FORMAT).sort(
    (x, y) => Number(x.session_id.slice(1)) - Number(y.session_id.slice(1)) || Number(x.window_index) - Number(y.window_index),
  );
  const panes = read("list-panes", PANE_FORMAT);
  const paneById = new Map(panes.map((p) => [p.pane_id, p]));
  const number = (id) => Number(id.slice(1));
  // A tool's pane stands for the pane it parked, so that one is handed off.
  const standsFor = (p) => (p["@in_place"] && paneById.has(p["@parked_pane"]) ? paneById.get(p["@parked_pane"]) : p);
  // Panes handed off: not a sidebar, nor a tool whose pane sits beside it
  // (pane-in-place.sh side), which is handed off once, as itself.
  const handedOff = (p) => p["@sidebar"] !== "1" && !(p["@in_place"] && paneById.get(p["@parked_pane"])?.window_id === p.window_id);
  const tabs = windows.filter((w) => w["@notices_window"] !== "1" && w["@pane_parked"] !== "1");
  const shown = tabs.flatMap((w) => panes.filter((p) => p.window_id === w.window_id && handedOff(p)).map(standsFor));

  // Each handed-off pane's options and, with save_contents on, its text, in
  // one tmux call, each answer after a line naming its pane by number, since
  // display-message reads a % as strftime does.
  const mark = `@@switchboard-handoff-${process.pid}@@`;
  const withText = windows[0]?.["@setting_save_contents"] === "on";
  const output = tmuxBatch(
    shown.flatMap((p) => [
      ["display-message", "-p", "-t", p.pane_id, `${mark}options ${number(p.pane_id)}`],
      ["show-options", "-p", "-t", p.pane_id],
      ...(withText ? [["display-message", "-p", "-t", p.pane_id, `${mark}text ${number(p.pane_id)}`], ["capture-pane", "-p", "-J", "-S", `-${CONTENT_LINES}`, "-t", p.pane_id]] : []),
    ]),
  );
  const answers = new Map();
  output.split(mark).slice(1).forEach((part) => {
    const newline = part.indexOf("\n");
    answers.set(part.slice(0, newline), part.slice(newline + 1));
  });

  const claudeByPane = new Map(claudeSessions().filter((s) => s.pane).map((s) => [`%${s.pane}`, s.sessionId]));
  const savedPane = (p) => {
    const opts = Object.fromEntries(Object.entries(parseOptions(answers.get(`options ${number(p.pane_id)}`) ?? "")).filter(([name]) => !dropPaneOption(name)));
    const pane = { id: number(p.pane_id), cwd: p.pane_current_path };
    if (Object.keys(opts).length) pane.opts = opts;
    // A worktree holding someone else's PR never has Claude resumed in it
    // (lib/untrusted.js), so its pane goes over as its shell.
    const claude = claudeByPane.get(p.pane_id);
    if (claude && !untrusted.isUntrusted(p.pane_current_path)) pane.claude = claude;
    else if (p["@notes_pane"] === "1") pane.command = ["switchboard", "notes"];
    const text = answers.get(`text ${number(p.pane_id)}`)?.replace(/\n+$/, "");
    if (text) pane.text = text;
    return pane;
  };

  const sessions = [];
  tabs.forEach((w) => {
    let session = sessions.find((s) => s.name === w.session_name);
    if (!session) {
      session = { name: w.session_name, cols: Number(w.window_width), rows: Number(w.window_height) + 1, current: undefined, last: null, tabs: [] };
      sessions.push(session);
    }
    const own = panes.filter((p) => p.window_id === w.window_id);
    const kept = new Map(own.filter(handedOff).map((p) => [number(p.pane_id), standsFor(p)]));
    const layout = toPortLayout(parseTmuxLayout(w.window_layout), (id) => kept.has(id), (id) => number(kept.get(id).pane_id));
    if (!layout) return;
    const ids = layoutPanes(layout);
    const handed = (flag) => {
      const p = own.find((pane) => pane[flag] === "1" && pane["@sidebar"] !== "1");
      return p && number(standsFor(p).pane_id);
    };
    const active = handed("pane_active") ?? ids[0];
    const lastPane = handed("pane_last");
    const opts = Object.fromEntries(TAB_OPTIONS.filter((name) => w[name] !== "").map((name) => [name, w[name]]));
    session.tabs.push({
      id: number(w.window_id),
      name: w["@tab_name"],
      layout,
      active,
      last_pane: lastPane !== undefined && lastPane !== active ? lastPane : null,
      zoomed: w.window_zoomed_flag === "1" && ids.length > 1,
      opts,
      panes: ids.map((id) => savedPane([...kept.values()].find((p) => number(p.pane_id) === id))),
    });
    if (w.window_active === "1") session.current = number(w.window_id);
    if (w.window_last_flag === "1") session.last = number(w.window_id);
  });
  sessions.forEach((s) => {
    if (s.current === undefined) s.current = s.tabs[0]?.id;
    if (s.last === s.current) s.last = null;
  });
  return { version: VERSION, sessions: sessions.filter((s) => s.tabs.length) };
};

// Writes layout.json as the port does: the one before kept as layout.json.1,
// the new one through a temporary file and a rename, readable by its owner
// alone, since what panes showed can hold secrets.
const writeLayout = (dir, saved) => {
  fs.mkdirSync(dir, { recursive: true, mode: 0o700 });
  const file = path.join(dir, "layout.json");
  const temp = path.join(dir, `.layout.json.${process.pid}`);
  fs.writeFileSync(temp, JSON.stringify(saved), { mode: 0o600 });
  try {
    fs.renameSync(file, path.join(dir, "layout.json.1"));
  } catch (error) {
    if (error.code !== "ENOENT") throw error;
  }
  fs.renameSync(temp, file);
};

const describe = (saved) =>
  saved.sessions.flatMap((s) => [
    `session ${s.name} (${s.tabs.length} tab${s.tabs.length === 1 ? "" : "s"})`,
    ...s.tabs.map((t) => {
      const what = t.panes.map((p) => (p.claude ? `%${p.id} claude ${p.claude}` : p.command ? `%${p.id} ${p.command.join(" ")}` : `%${p.id} ${tilde(p.cwd ?? "~")}`));
      return `  @${t.id} ${t.name || "(named after its directory)"}: ${what.join(", ")}`;
    }),
  ]);

const handoff = (opts) => {
  checkStateDir(opts.stateDir);
  const saved = snapshot();
  const { copy, skipped } = plan(opts.stateDir, opts.port && portNames(opts.port));
  const claudes = saved.sessions.flatMap((s) => s.tabs.flatMap((t) => t.panes.filter((p) => p.claude)));
  console.log(describe(saved).join("\n"));
  console.log();
  copy.forEach((f) => console.log(`${opts.dryRun ? "would copy" : "copy"} ${tilde(f.ours)} -> ${tilde(f.theirs)}${fs.existsSync(f.ours) ? "" : " (not there, nothing to copy)"}`));
  skipped.forEach((f) => console.log(`skip ${tilde(f.ours)}: ${f.why}`));
  if (!opts.dryRun) {
    writeLayout(opts.stateDir, saved);
    copy.forEach((f) => copyFiles(f.ours, f.theirs, false));
    console.log(`\nWrote ${tilde(path.join(opts.stateDir, "layout.json"))}.`);
  }
  if (claudes.length) {
    console.log(`\n${claudes.length} Claude session${claudes.length === 1 ? " is" : "s are"} still running here, and the port will resume ${claudes.length === 1 ? "it" : "them"}; two Claudes mustn't carry on the same conversation.`);
  }
  console.log(`\nTo cut over: quit each Claude here (or tmux kill-server), then start the port with SWITCHBOARD_STATE_DIR=${tilde(opts.stateDir)} switchboard`);
};

// ── The way back ─────────────────────────────────────────────────────────────

const readLayout = (dir) => {
  for (const name of ["layout.json", "layout.json.1"]) {
    const file = path.join(dir, name);
    let text;
    try {
      text = fs.readFileSync(file, "utf8");
    } catch (error) {
      if (error.code === "ENOENT") continue;
      fail(`can't read ${tilde(file)}: ${error.message}`);
    }
    let saved;
    try {
      saved = JSON.parse(text);
    } catch (error) {
      fail(`${tilde(file)} isn't JSON: ${error.message}`);
    }
    if (saved.version !== VERSION) fail(`${tilde(file)} is version ${saved.version}, and this reads ${VERSION}`);
    return saved;
  }
  fail(`there is no layout.json in ${tilde(dir)}`);
};

// What restoring a pane runs: Claude resumed, Notes started, else its shell.
const notesCommand = process.env.NOTES_OPEN_COMMAND || "zsh -i -c notes";
const isNotes = (p) => p.command?.length === 2 && p.command[0] === "switchboard" && p.command[1] === "notes";

// Splits `pane` into the tree `layout` (tmux's split-window, children in
// order, each new pane to the right or below), returning saved id -> tmux pane.
const splitInto = (pane, layout, cwdOf, made) => {
  if (layout.Pane !== undefined) {
    made.set(layout.Pane, pane);
    return;
  }
  const { across, children, shares } = layout.Split;
  const parts = [pane];
  for (let i = 0; i < children.length - 1; i++) {
    const rest = shares.slice(i + 1).reduce((a, b) => a + b, 0);
    const here = shares.slice(i).reduce((a, b) => a + b, 0);
    const percent = Math.min(99, Math.max(1, Math.round((rest / here) * 100)));
    const next = tmux(["split-window", "-d", across ? "-h" : "-v", "-l", `${percent}%`, "-t", parts[i], "-c", cwdOf(layoutPanes(children[i + 1])[0]), "-P", "-F", "#{pane_id}"]).trim();
    parts.push(next);
  }
  children.forEach((child, i) => splitInto(parts[i], child, cwdOf, made));
};

const existingSessions = () => {
  try {
    return new Set(tmux(["list-sessions", "-F", "#{session_name}"]).split("\n").filter(Boolean));
  } catch {
    return new Set();
  }
};

const back = (opts) => {
  checkStateDir(opts.stateDir);
  const saved = readLayout(opts.stateDir);
  const { copy } = plan(opts.stateDir);
  const ids = saved.sessions.flatMap((s) => s.tabs.flatMap((t) => t.panes.map((p) => p.claude).filter(safeId)));
  const running = new Set(claudeSessions().map((s) => s.sessionId));
  const stillRunning = ids.filter((id) => running.has(id));
  console.log(describe(saved).join("\n"));
  console.log();
  copy.forEach((f) => console.log(`${opts.dryRun ? "would copy back" : "copy back"} ${tilde(f.theirs)} -> ${tilde(f.ours)}, where newer`));
  if (stillRunning.length) console.log(`\n${stillRunning.length} of these Claude sessions still run${stillRunning.length === 1 ? "s" : ""} somewhere (${stillRunning.join(", ")}): quit ${stillRunning.length === 1 ? "it" : "them"} in the port first, or two Claudes will carry on the same conversation.`);
  if (opts.dryRun) {
    console.log("\nTo come back: quit the port's Claudes (or its server), then run switchboard-handoff --back.");
    return;
  }

  const have = existingSessions();
  // Notes beside another tab's pane hides its own sidebar, as notes-open.sh
  // starts it there, unless the notes_hide_sidebar setting is off.
  let hideSidebar = true;
  try {
    hideSidebar = tmux(["show-options", "-gqv", "@setting_notes_hide_sidebar"]).trim() !== "off";
  } catch {}
  // Only one Notes runs, since two would save over each other's notes (its
  // lock refuses the second): when tmux already has one, a saved Notes pane
  // comes back as its shell, without the marks that would take it for Notes.
  let notesOpen = false;
  try {
    // A pane marked @notes_pane, not the placeholder M-e leaves in Notes' own
    // tab, which stays after Notes is quit.
    notesOpen = tmux(["list-panes", "-a", "-F", "#{?@notes_placeholder,0,#{?@notes_pane,1,0}}"]).includes("1");
  } catch {}
  // Or a Notes outside this tmux, found by the lock it holds on the notes
  // directory (.notes.lock, its process ID), as store.lua's lock refuses it.
  if (!notesOpen) {
    const lock = path.join(process.env.NOTES_DIR || path.join(HOME, "Notes"), ".notes.lock");
    const pid = Number(fs.existsSync(lock) && fs.readFileSync(lock, "utf8").trim());
    notesOpen = pid > 0 && alive(pid);
  }
  const notesMarks = new Set(["@notes_pane", "@notes", "@notes_beside", "@notes_placeholder"]);
  // The placeholder M-e leaves in Notes' own tab (notes-away.sh) comes back
  // as itself only beside the Notes this restores; otherwise it is a shell,
  // without the marks that would take it for Notes' tab.
  const restoringNotes = !notesOpen && saved.sessions.some((s) => s.tabs.some((t) => t.panes.some(isNotes)));
  const placeholder = (p) => p.opts?.["@notes_placeholder"] === "1";
  const notesAway = path.join(__dirname, "../tmux/notes-away.sh");
  saved.sessions.forEach((s) => {
    const tabs = s.tabs.filter((t) => t.layout && t.panes.length);
    if (!s.name || !tabs.length) return;
    const fresh = !have.has(s.name);
    const windowOf = new Map();
    const batch = [];
    tabs.forEach((t, i) => {
      const byId = new Map(t.panes.map((p) => [p.id, p]));
      const cwdOf = (id) => {
        const dir = byId.get(id)?.cwd;
        return dir && fs.existsSync(dir) ? dir : HOME;
      };
      const first = layoutPanes(t.layout)[0];
      const [window, pane] = (
        fresh && i === 0
          ? tmux(["new-session", "-d", "-s", s.name, "-x", String(s.cols || 200), "-y", String(s.rows || 50), "-c", cwdOf(first), "-P", "-F", "#{window_id} #{pane_id}"])
          : tmux(["new-window", "-d", "-t", `=${s.name}:`, "-c", cwdOf(first), "-P", "-F", "#{window_id} #{pane_id}"])
      )
        .trim()
        .split(" ");
      windowOf.set(t.id, window);
      const made = new Map();
      splitInto(pane, t.layout, cwdOf, made);
      const notesHere = !notesOpen && t.panes.some(isNotes);
      if (notesHere) notesOpen = true;
      const unmarked = (t.panes.some(isNotes) && !notesHere) || (t.panes.some(placeholder) && !restoringNotes);
      const tabOptions = Object.fromEntries(Object.entries(t.opts ?? {}).filter(([name]) => !(unmarked && notesMarks.has(name))));
      if (t.name && !tabOptions["@tab_name"]) tabOptions["@tab_name"] = t.name;
      Object.entries(tabOptions).forEach(([name, value]) => name.startsWith("@") && batch.push(["set-option", "-w", "-t", window, name, String(value)]));
      t.panes.forEach((p) => {
        const target = made.get(p.id);
        if (!target) return;
        Object.entries(p.opts ?? {}).forEach(([name, value]) => name.startsWith("@") && !dropPaneOption(name) && !(((isNotes(p) && !notesHere) || (placeholder(p) && !restoringNotes)) && notesMarks.has(name)) && batch.push(["set-option", "-p", "-t", target, name, String(value)]));
        // A Claude whose directory is gone (a worktree removed since) isn't
        // resumed in the home the pane falls back to, where its project isn't.
        const goneDir = safeId(p.claude) && !(p.cwd && fs.existsSync(p.cwd));
        if (goneDir) console.error(`switchboard-handoff: ${p.cwd ? tilde(p.cwd) : "its directory"} is gone, so Claude ${p.claude} isn't resumed; claude --resume ${p.claude} resumes it where you choose`);
        else if (safeId(p.claude) && untrusted.isUntrusted(cwdOf(p.id))) console.error(untrusted.refusal(tilde(cwdOf(p.id))));
        else if (safeId(p.claude)) batch.push(["send-keys", "-t", target, "-l", `claude --resume ${p.claude}`], ["send-keys", "-t", target, "Enter"]);
        else if (isNotes(p) && notesHere) batch.push(["respawn-pane", "-k", "-t", target, "-c", cwdOf(p.id), "-e", `NOTES_SIDEBAR=${t.opts?.["@notes_beside"] === "1" && hideSidebar ? "off" : "on"}`, notesCommand], ["set-option", "-p", "-t", target, "@notes_pane", "1"]);
        else if (placeholder(p) && restoringNotes) batch.push(["respawn-pane", "-k", "-t", target, "-c", HOME, notesAway]);
      });
      const active = made.get(t.active) ?? pane;
      if (made.has(t.last_pane)) batch.push(["select-pane", "-t", made.get(t.last_pane)]);
      batch.push(["select-pane", "-t", active]);
      if (t.zoomed && made.size > 1) batch.push(["resize-pane", "-Z", "-t", active]);
    });
    // The saved last and current tab, in a session there before too, so the
    // session comes back on the tab it was on in the port.
    if (windowOf.has(s.last)) batch.push(["select-window", "-t", windowOf.get(s.last)]);
    if (windowOf.has(s.current)) batch.push(["select-window", "-t", windowOf.get(s.current)]);
    tmuxBatch(batch);
  });
  const copied = copy.reduce((sum, f) => sum + copyFiles(f.theirs, f.ours, true), 0);
  // The health light reads connectors-down, which lib/connector.js writes
  // from connectors.json, so it is written again from the file now kept.
  try {
    const status = JSON.parse(fs.readFileSync(path.join(SIDEBAR_STATE, "connectors.json"), "utf8"));
    const down = Object.entries(status).filter(([, c]) => !c.ok).map(([name, c]) => `${name}\t${Math.floor(c.at / 1000)}\n`);
    fs.writeFileSync(path.join(SIDEBAR_STATE, "connectors-down"), down.join(""));
  } catch {}
  console.log(`\nRecreated ${saved.sessions.reduce((sum, s) => sum + s.tabs.length, 0)} tabs and copied back ${copied} newer state file${copied === 1 ? "" : "s"}.`);
};

if (require.main === module) {
  const opts = parseArgs(process.argv.slice(2));
  if (opts.back) back(opts);
  else handoff(opts);
}

module.exports = { parseTmuxLayout, toPortLayout, unquote, parseOptions, STATE_FILES };
