#!/usr/bin/env node

// skill-path <name> [<dir>]
//
// The SKILL.md to follow for the skill <name> in the repository at <dir>
// (default the current directory): the worktree's own
// .claude/skills/<name>/SKILL.md, else its main clone's (a branch cut before
// the repository added the skill has none of its own), else the personal one,
// ~/.claude/skills/<name>/SKILL.md, else Switchboard's plugin's,
// ~/switchboard/claude/plugin/skills/<name>/SKILL.md, which its tmux panes load
// in place of personal ones. Outside a git repository, the last two.
// Prints nothing and exits 1 when there is none.
//
// Every Switchboard skill runs it first and follows the repository's copy when
// it prints one, and a skill handing off to another reads the file it prints,
// since Claude Code itself runs a personal skill over a project's of the same
// name.
//
// In a worktree of someone else's PR (wtpr --untrusted, switchboard.untrusted
// in its own config), the worktree's own copy is passed over: its skills are
// the PR author's, and a review-loop of theirs would rewrite the review of
// their change.

const { execFileSync } = require("node:child_process");
const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");

const [name, dir = process.cwd()] = process.argv.slice(2);
if (!name || name.startsWith("-")) {
  process.stderr.write("usage: skill-path <name> [<dir>]\n");
  process.exit(2);
}

function git(...args) {
  try {
    return execFileSync("git", ["-C", dir, ...args], { encoding: "utf8", stdio: ["ignore", "pipe", "ignore"] }).trim();
  } catch {
    return "";
  }
}

const roots = [];
const top = git("rev-parse", "--show-toplevel");
if (top) {
  if (git("config", "--get", "switchboard.untrusted") !== "true") roots.push(top);
  else process.stderr.write(`skill-path: ${top} holds an untrusted PR, so its own skills are passed over\n`);
  const common = git("rev-parse", "--path-format=absolute", "--git-common-dir");
  if (common) roots.push(path.dirname(common));
}
const candidates = roots.map((root) => path.join(root, ".claude/skills", name, "SKILL.md"));
candidates.push(path.join(os.homedir(), ".claude/skills", name, "SKILL.md"));
candidates.push(path.join(os.homedir(), "switchboard/claude/plugin/skills", name, "SKILL.md"));

const found = candidates.find((file) => fs.existsSync(file));
if (!found) process.exit(1);
console.log(found);
