#!/usr/bin/env node

// leak-check <range>
//
// Looks for anything that identifies you or your employer in what a range of
// commits adds, before it is pushed to a public repository: each line any of
// its commits adds (`git log -p -m <range>`, every commit and a merge against
// each parent, so a line a later commit removes still counts, since the push
// carries every commit) and each commit message.
// It finds
//
//   - the words in ~/.config/switchboard/leak-check.txt, one a line (your
//     organization's and company's names, usernames, internal hosts; blank
//     lines and lines starting with # left out), as whole words, any case;
//   - Linear-style ticket IDs (a team key, a dash, a number) and PR numbers
//     written as a # and three digits or more,
//     except in tests, whose IDs are made up (and ABC-…, XYZ-…, #123 and
//     #12345 anywhere, the made-up ones the docs use);
//   - home directory paths (/Users/<name>), email addresses (but noreply and
//     example ones), and token shapes (GitHub's, OpenAI-style sk-, Slack's).
//
// It prints each hit as `<file>:<line>: <kind>: <text>`, or
// `commit <hash>: <kind>: <text>` for a message, and exits 1 on any, 0 on
// none, 2 when it can't look. queue-and-clean runs it before a direct landing
// asks to push, and a landing without asking (the work-a-note mode's "Land
// without asking") asks after all when it finds anything.

const { execFileSync } = require("node:child_process");
const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");

const range = process.argv[2];
if (!range || process.argv.length > 3) {
  console.error("usage: leak-check <range>");
  process.exit(2);
}

const git = (...args) => execFileSync("git", args, { encoding: "utf8", maxBuffer: 256 * 1024 * 1024, stdio: ["ignore", "pipe", "pipe"] });

const WORDS_FILE = path.join(os.homedir(), ".config/switchboard/leak-check.txt");
const words = (() => {
  try {
    return fs
      .readFileSync(WORDS_FILE, "utf8")
      .split("\n")
      .map((line) => line.trim())
      .filter((line) => line && !line.startsWith("#"));
  } catch (err) {
    // No list is fine; one that is there but can't be read stops the check,
    // so a landing asks rather than pushing unchecked.
    if (err.code === "ENOENT") return [];
    console.error(`leak-check: can't read ${WORDS_FILE}: ${err.message}`);
    process.exit(2);
  }
})();
const escape = (text) => text.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");

// Standards, and key names (M-1, C-2), that look like ticket IDs.
const NOT_TICKETS = new Set(["UTF", "SHA", "ISO", "RFC", "CVE", "HTTP", "TLS", "SSL", "AES", "RSA", "ECMA", "IPV", "UTC", "GMT", "ASCII", "ABC", "XYZ", "CP", "MD", "ES", "WCAG", "BASE", "LF", "CRLF", "PEP", "POSIX", "IEEE", "ANSI", "OSC", "CSI", "DCS", "SGR", "DEC", "VT", "XTERM", "TODO", "NOTE", "UID", "GID", "PID", "SIG", "MPL", "GPL", "LGPL", "AGPL", "BSD", "CC", "APACHE", "M", "C", "S"]);
const PLACEHOLDER_USERS = new Set(["me", "you", "someone", "name", "user", "username", "example", "test", "x", "shared"]);
// Made-up and generic addresses: noreply and example ones, git's SSH user
// and a placeholder user in a URL at the big git hosts, and in tests any at
// the big hosts, whose calendar event IDs look like addresses.
const OK_EMAIL = /(^|[.@])(noreply|no-reply)[@.]|@(example\.(com|org|net)|[\w.-]+\.example|localhost)$|@users\.noreply\.github\.com$|^(git|me|you|user|someone)@((ssh\.)?github\.com|gitlab\.com|bitbucket\.org)$/i;
const OK_TEST_EMAIL = /@(google|github|gitlab)\.com$/i;

// What one line holds, `test` whether it is in a test file.
const hitsIn = (text, test) => {
  const hits = [];
  for (const word of words) {
    const match = new RegExp(`(?<![\\w])${escape(word)}(?![\\w])`, "i").exec(text);
    if (match) hits.push(["listed word", match[0]]);
  }
  if (!test) {
    for (const [ticket, prefix] of text.matchAll(/(?<![\w-])([A-Z][A-Z0-9]*)-\d+(?!\w)/g)) if (!NOT_TICKETS.has(prefix)) hits.push(["ticket ID", ticket]);
    // A color (color: #202124, "background": "#000000", bg = "#000") is no
    // PR: one of 3 or 6 digits given as a color property's value.
    const color = (pr, index) => /^#(\d{3}|\d{6})$/.test(pr) && /(colou?r|background|fill|stroke|border|\b[bf]g)[\w-]*["']?\s*[:=]\s*["']?$/i.test(text.slice(0, index));
    for (const { 0: pr, index } of text.matchAll(/(?<![\w&#/])#\d{3,}(?![\w])/g)) if (!["#123", "#12345"].includes(pr) && !color(pr, index)) hits.push(["PR number", pr]);
  }
  for (const [p, user] of text.matchAll(/\/Users\/([A-Za-z][\w.-]*)/g)) if (!PLACEHOLDER_USERS.has(user.toLowerCase())) hits.push(["home path", p]);
  for (const [email] of text.matchAll(/(?<![\w.+-])[\w.+-]+@[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)*\.[A-Za-z]{2,}(?![\w-])/g)) if (!OK_EMAIL.test(email) && !(test && OK_TEST_EMAIL.test(email))) hits.push(["email address", email]);
  for (const [token] of text.matchAll(/(?<![\w-])(gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|sk-[A-Za-z0-9_-]{20,}|xox[abprs]-[A-Za-z0-9-]{10,}|xapp-[A-Za-z0-9-]{10,})/g)) hits.push(["token", `${token.slice(0, 8)}…`]);
  return hits;
};

const isTest = (file) => /(^|\/)(test|tests|__tests__|spec)\//.test(file) || /\.(test|spec)\.[^/]+$/.test(file);

let diff;
let log;
try {
  diff = git("log", "--no-color", "--no-ext-diff", "--no-textconv", "--text", "--unified=0", "--no-renames", "-p", "-m", "--format=", range, "--");
  log = git("log", "--no-color", "--no-textconv", "--format=%h%x00%B%x00", range, "--");
} catch (err) {
  console.error(`leak-check: ${String(err.stderr || err.message).trim()}`);
  process.exit(2);
}

const found = [];
let file = "";
let line = 0;
for (const row of diff.split("\n")) {
  if (row.startsWith("diff --git ")) {
    file = "";
    continue;
  }
  if (row.startsWith("+++ ")) {
    file = row === "+++ /dev/null" ? "" : row.replace(/^\+\+\+ b\//, "");
    continue;
  }
  const hunk = /^@@ -\S+ \+(\d+)/.exec(row);
  if (hunk) {
    line = Number(hunk[1]);
    continue;
  }
  if (!file || !row.startsWith("+")) continue;
  for (const [kind, text] of hitsIn(row.slice(1), isTest(file))) found.push(`${file}:${line}: ${kind}: ${text}`);
  line += 1;
}
const parts = log.split("\0");
for (let i = 0; i + 1 < parts.length; i += 2) {
  const hash = parts[i].trim();
  // The trailers Claude Code adds name a model, not you.
  const message = parts[i + 1].split("\n").filter((l) => !/^Co-Authored-By: Claude\b/i.test(l)).join("\n");
  for (const [kind, text] of hitsIn(message, false)) found.push(`commit ${hash}: ${kind}: ${text}`);
}

for (const hit of [...new Set(found)]) console.log(hit);
process.exit(found.length ? 1 : 0);
