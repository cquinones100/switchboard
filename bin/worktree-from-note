#!/usr/bin/env node

// worktree-from-note [path] --note <note> --item <line> [--prompt <text>]
//
// Creates a git worktree on a new branch named after a checklist item in one
// of your notes (the notes app's Markdown files, in $NOTES_DIR or ~/Notes) and
// opens claude in it, told to work on the item and its plan. For repositories
// like Switchboard that keep their work in a note and commit straight to main:
// /queue-and-clean lands the branch on main once the work is done.
//
// <note> is the note's path, absolute or within the notes directory, ".md"
// optional; <line> is the item's line number in it, an unticked "- [ ]" line
// of the note's top level. <path> defaults to .claude/worktrees, resolved
// against the main repo root.
//
//   worktree-from-note --note "Switchboard Notes" --item 12
//   worktree-from-note init zsh         prints the `wtn` shell function

const { spawnSync } = require("node:child_process");
const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");
const { slugify, gitOutput, gitRun, repoRoot, linkLocalSettings, ensureWorktree } = require("../lib/worktree");
const { count } = require("../lib/requests");

const DEFAULT_WORKTREE_DIR = ".claude/worktrees";
const SELF = fs.realpathSync(process.argv[1]);
// A branch name short enough to read in a tab and a prompt.
const SLUG_LENGTH = 50;

const usage = () => {
  console.error(
    "Usage: worktree-from-note [path] --note <note> --item <line> [--prompt <text>]\n" +
      "       worktree-from-note init <zsh|bash>\n\n" +
      "Examples:\n" +
      '  worktree-from-note --note "Switchboard Notes" --item 12\n' +
      `\nPath defaults to ${DEFAULT_WORKTREE_DIR} under the repo root.\n` +
      "--prompt adds to the prompt Claude starts with. The wtn function also takes\n" +
      "it from WT_PROMPT, and the note from WTN_NOTE, clearing both, so /wtn can\n" +
      "hand them over.",
  );
  process.exit(1);
};

const fail = (message) => {
  console.error(`Error: ${message}`);
  process.exit(1);
};

// Emitted for `eval "$(worktree-from-note init zsh)"`, as worktree-from-ticket's
// `wt`: it runs the script with --no-claude, cd's into the worktree, names the
// tabs again and starts claude there, so the shell sits in the worktree for the
// whole session. The prompt is every line of the cd-file after the first,
// since the item it carries can run to several.
//
// WT_PROMPT and WTN_NOTE, which /wtn sets on the pane it respawns, are passed
// on and cleared, so the note's path never has to be quoted into a command.
const shellFunction = () => `wtn() {
  local cdfile rc dir prompt
  local -a extra
  extra=()
  [ -n "\${WT_PROMPT:-}" ] && extra+=(--prompt "$WT_PROMPT")
  [ -n "\${WTN_NOTE:-}" ] && extra+=(--note "$WTN_NOTE")
  unset WT_PROMPT WTN_NOTE
  cdfile=$(mktemp) || return 1
  ${SELF} --no-claude --cd-file "$cdfile" "\${extra[@]}" "$@"
  rc=$?
  if [ $rc -ne 0 ]; then
    rm -f "$cdfile"
    return $rc
  fi
  dir=$(sed -n 1p "$cdfile")
  prompt=$(sed -n '2,$p' "$cdfile")
  rm -f "$cdfile"
  if [ ! -d "$dir" ]; then
    echo "wtn: expected a worktree directory, got: $dir" >&2
    return 1
  fi
  cd "$dir" || return 1
  if [ -n "$TMUX_PANE" ]; then
    ~/.config/tmux/window-names.sh "$(tmux display-message -p -t "$TMUX_PANE" '#{session_name}')"
  fi
  claude "$prompt"
}`;

const notesDir = () => fs.realpathSync(process.env.NOTES_DIR || path.join(os.homedir(), "Notes"));

// The note's file: a path, absolute or within the notes directory, ".md"
// added when left off, and only ever a note of the notes directory, not a
// deleted one.
const noteFile = (dir, note) => {
  const given = path.resolve(dir, note);
  const candidates = given.endsWith(".md") ? [given] : [given, `${given}.md`];
  const found = candidates.find((file) => fs.existsSync(file) && fs.statSync(file).isFile());
  if (!found) fail(`no note at ${given}`);
  const real = fs.realpathSync(found);
  const inside = path.relative(dir, real);
  if (inside.startsWith("..") || path.isAbsolute(inside) || inside.split(path.sep)[0] === ".trash") {
    fail(`${found} is not a note of ${dir}`);
  }
  return real;
};

// A Plan note linked from the item ("Plan: [[Plan - <title>]]"), found by its
// file name anywhere in the notes directory but its deleted notes.
const planFile = (dir, name) => {
  const walk = (folder) =>
    fs.readdirSync(folder, { withFileTypes: true }).flatMap((entry) => {
      if (entry.name === ".trash" || entry.name.startsWith(".")) return [];
      const full = path.join(folder, entry.name);
      if (entry.isDirectory()) return walk(full);
      return entry.name === `${name}.md` ? [full] : [];
    });
  return walk(dir)[0];
};

const main = () => {
  // Each --prompt, --note and --item with its text comes out first, so text
  // that reads as a flag is only ever its value; several prompts are joined.
  const argv = [];
  const prompts = [];
  let note;
  let item;
  const all = process.argv.slice(2);
  for (let index = 0; index < all.length; index++) {
    const flag = all[index];
    if (!["--prompt", "--note", "--item"].includes(flag)) {
      argv.push(flag);
      continue;
    }
    if (index + 1 >= all.length) fail(`${flag} requires a value`);
    const value = all[++index];
    if (flag === "--prompt") prompts.push(value);
    else if (flag === "--note") note = value;
    else item = value;
  }

  if (argv[0] === "init") {
    if (!["zsh", "bash"].includes(argv[1])) fail("init requires a shell: worktree-from-note init <zsh|bash>");
    console.log(shellFunction());
    return;
  }
  if (argv.includes("--help") || argv.includes("-h")) usage();

  const cdFileIndex = argv.indexOf("--cd-file");
  const cdFile = cdFileIndex === -1 ? undefined : argv[cdFileIndex + 1];
  if (cdFileIndex !== -1 && !cdFile) fail("--cd-file requires a path");
  const noClaude = argv.includes("--no-claude");
  const consumed = new Set(cdFileIndex === -1 ? [] : [cdFileIndex, cdFileIndex + 1]);
  const positional = argv.filter((arg, index) => !consumed.has(index) && arg !== "--no-claude");
  if (positional.length > 1 || !note || !item) usage();
  if (!/^\d+$/.test(item)) fail(`--item takes the item's line number, not "${item}"`);
  const targetPath = positional[0] ?? DEFAULT_WORKTREE_DIR;

  const dir = notesDir();
  const file = noteFile(dir, note);
  const lines = fs.readFileSync(file, "utf8").split("\n");
  const at = Number(item) - 1;
  const line = lines[at];
  if (line === undefined) fail(`${path.basename(file)} has no line ${item}`);
  if (/^- \[[xX]\] /.test(line)) fail(`line ${item} of ${path.basename(file)} is ticked already: ${line}`);
  const first = line.match(/^- \[ \] (.*\S.*)$/)?.[1].trim();
  if (!first) fail(`line ${item} of ${path.basename(file)} is not an unticked checklist item: ${line}`);
  // Two items worded alike can't be told apart once one has a worktree.
  if (lines.filter((other) => other.match(/^- \[ \] (.*\S.*)$/)?.[1].trim() === first).length > 1) fail(`${path.basename(file)} has more than one item reading "${first}": reword one first`);
  // The item and what is indented under it, blank lines between included, up
  // to the next line of the note's top level.
  const rest = [];
  for (let next = at + 1; next < lines.length && !/^\S/.test(lines[next]); next++) rest.push(lines[next]);
  while (rest.length && !rest.at(-1).trim()) rest.pop();
  const text = [line, ...rest].join("\n");

  const slug = slugify(first).slice(0, SLUG_LENGTH).replace(/-+$/, "");
  if (!slug) fail(`the item's first line has nothing to name a branch after: ${first}`);
  const branch = `note/${slug}`;
  const root = repoRoot();
  // note-<slug>, the branch's name made flat, as wtb makes a branch's, so a
  // worktree of another branch named like the item is never this one's.
  const worktreePath = path.resolve(root, targetPath, `note-${slug}`);
  const title = lines[0].replace(/^#\s*/, "").trim() || path.basename(file, ".md");
  const planName = text.match(/Plan: \[\[([^\]]+)\]\]/)?.[1];
  const plan = planName && planFile(dir, planName);

  console.error(`Note:     ${title}`);
  console.error(`Item:     ${first}`);
  if (planName) console.error(`Plan:     ${plan ?? `${planName} (not found)`}`);
  console.error(`Branch:   ${branch}`);
  console.error(`Worktree: ${worktreePath}`);

  // Which item the branch is for, the note's path within the notes
  // directory and the item's first line, kept in its git config, so another
  // item whose first line slugs the same, in this note or another, is refused
  // rather than started inside this one's work.
  const identity = `${path.relative(dir, file)}: ${first}`;
  const recorded = (() => {
    try {
      return gitOutput(["-C", root, "config", "--get", `branch.${branch}.wtnItem`]);
    } catch {
      return "";
    }
  })();
  if (recorded && recorded !== identity) {
    fail(
      `${branch} is for another item: "${recorded}".\n` +
        `Land or remove that worktree first, or, if the item was only reworded, tell git it is the same one:\n` +
        `  git config branch.${branch}.wtnItem '${identity.replace(/'/g, "'\\''")}'`,
    );
  }
  // A new branch starts from origin's default branch as it is now (else the
  // main clone's HEAD, with no remote), never from the worktree /wtn was run
  // in, whose own commits would then land with this item's.
  // A fetch that fails stops it, since the main clone's own unpushed commits
  // would otherwise land with the item.
  const start = (() => {
    if (!gitOutput(["-C", root, "remote"]).split("\n").includes("origin")) return gitOutput(["-C", root, "rev-parse", "HEAD"]);
    // Each fetch counted in the request audit under origin's host, as
    // codex-review counts its own; none for an origin on this Mac.
    const url = gitOutput(["-C", root, "remote", "get-url", "origin"]);
    const remote = url.startsWith("file:") ? null : /^[A-Za-z][A-Za-z0-9+.-]*:\/\//.test(url) ? url.replace(/^[^:]+:\/\//, "") : /^[^/]+:/.test(url) ? url : null;
    const host = remote && remote.replace(/^[^@/]*@/, "").split(/[/:]/)[0];
    const fetched = (base) => {
      if (host) count(/^(gist\.)?github\.com$/.test(host) ? "GitHub" : host, "git", "wtn: fetch the base");
      try {
        gitRun(["-C", root, "fetch", "origin", `+refs/heads/${base}:refs/remotes/origin/${base}`], { stdio: ["ignore", 2, "ignore"] });
        return true;
      } catch {
        return false;
      }
    };
    const named = (() => {
      try {
        return gitOutput(["-C", root, "symbolic-ref", "--short", "refs/remotes/origin/HEAD"]).replace(/^origin\//, "");
      } catch {
        return undefined;
      }
    })();
    const base = named ? (fetched(named) ? named : undefined) : ["main", "master"].find(fetched);
    if (!base) fail(`couldn't fetch origin's ${named ?? "main or master"}, which the item's branch starts from`);
    return `origin/${base}`;
  })();
  ensureWorktree(worktreePath, branch, { work: "item", command: "wtn", start });
  gitRun(["-C", root, "config", `branch.${branch}.wtnItem`, identity]);
  linkLocalSettings(root, worktreePath);

  const extra = prompts.join(" ").replace(/\s+/g, " ").trim();
  const prompt =
    `Work on this checklist item from my note "${title}" (${file}), line ${item} there, as written:\n\n` +
    `<item>\n${text}\n</item>\n\n` +
    (plan
      ? `Its plan is ${plan}: read it first, and before building, ask me about any choice it still marks as needed. `
      : planName
        ? `It links a plan, "${planName}", that isn't in the notes directory: tell me before going on. `
        : "It has no plan: read the code the item touches, and ask me before building anything it leaves open. ") +
    "This repository commits straight to main with no PR, so commit the work on this worktree's branch, following the repository's CLAUDE.md, and don't push it or tick the item in the note. " +
    "When the work is done, say so in a line, then land it as /queue-and-clean does, which only I can start, so read ~/.claude/skills/queue-and-clean/SKILL.md and follow it: it reviews the work, asks me before pushing, lands it on main and ticks the item." +
    (extra ? ` Also, from me for this item: ${extra}` : "");

  // Read by the `wtn` shell function: line 1 the worktree path, the rest the prompt.
  if (cdFile) fs.writeFileSync(cdFile, `${worktreePath}\n${prompt}\n`);
  if (noClaude) return;

  const claude = spawnSync("claude", [prompt], { cwd: worktreePath, stdio: "inherit" });
  if (claude.error?.code === "ENOENT") {
    console.error(`\nclaude not found on PATH. The worktree is ready at:\n  ${worktreePath}`);
    return;
  }
  if (claude.status) process.exit(claude.status);
};

try {
  main();
} catch (err) {
  fail(err.message);
}
