{
  "permissions": {
    "allow": [
      "Bash(cargo build --release --locked)",
      "Bash(install -m 755 target/release/switchboard ~/.local/bin/)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/enforce-push-review.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/enforce-git-hooks-run.sh\""
          }
        ]
      }
    ]
  }
}
