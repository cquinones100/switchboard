#!/usr/bin/env bash

# Refuses a push to main that /review-loop hasn't found clean: the skill, after
# two clean rounds in a row, records the commit it reviewed and where the
# reviewed range started (codex-review's reviewedCommit and mergeBase) in the
# clone's review-loop-clean file (git rev-parse --git-path review-loop-clean).
# The tip pushed to main must be that commit, and the range's start must be
# in main as it is on the remote, so every commit the push adds was reviewed,
# not only the last few. A commit made after the review, a fix or anything
# else, needs a review of its own. Pushes to other branches are left alone.
#
# The reviewed commit rebased onto a newer main counts too, when the push adds
# one commit, straight on main on the remote (the reviewed base in it, so it
# is a newer main, not an older one missing what the change needs), making
# exactly the change the review covered, under the reviewed commit's own
# message (one commit, since
# commits that add something and take it out again would leave the same
# change and an unreviewed history): its third field is the reviewed
# range's patch (codex-review's patchId), which must equal the patch from main
# on the remote to the tip pushed (switchboard codex-review --patch-id, the one
# place it is worked out). The patch takes in each change's context lines, so
# a commit rebased past a change beside its own no longer matches and needs a
# review of its own; queue-and-clean's landing checks the same before it
# pushes.
#
# Claude can't get around it (.claude/hooks/enforce-push-review.sh blocks
# `git push --no-verify`); you can, by hand, with `git push --no-verify`.
#
# Enabled per clone with `git config core.hooksPath "$PWD/.githooks"` at its
# top: the full path, so a worktree runs this, the main clone's hook, and
# never one its branch carries, which git would run from a relative path.

# The switchboard asked for the setting and the patch: the one on the PATH,
# else the one built in the clone this hook is in, never the worktree the
# push runs in, whose build is its branch's code.
sb=$(command -v switchboard 2>/dev/null)
clone=$(cd "$(dirname "$0")/.." 2>/dev/null && pwd -P)
for built in "$clone/target/release/switchboard" "$clone/target/debug/switchboard"; do
  [ -z "$sb" ] && [ -x "$built" ] && sb=$built
done

# Turned off in Settings (review_before_push), it asks for nothing, read as
# Settings reads it: a value Settings can't read, or a file it can't, is on.
# Without a switchboard to ask, it is on.
[ -n "$sb" ] && [ "$("$sb" setting review_before_push 2>/dev/null)" = off ] && exit 0

read -r reviewed reviewed_base reviewed_patch 2>/dev/null <"$(git rev-parse --git-path review-loop-clean)"
same_patch() {
  [ -n "$sb" ] && [ -n "$reviewed_patch" ] && [ "$remote_sha" != "$zero" ] && [ -n "$reviewed_base" ] &&
    git merge-base --is-ancestor "$reviewed_base" "$remote_sha" 2>/dev/null &&
    [ "$(git rev-list --parents -n 1 "$local_sha" 2>/dev/null)" = "$local_sha $remote_sha" ] &&
    [ "$(git log -1 --format=%B "$local_sha" 2>/dev/null)" = "$(git log -1 --format=%B "$reviewed" 2>/dev/null)" ] &&
    [ "$("$sb" codex-review --patch-id "$remote_sha" "$local_sha" 2>/dev/null)" = "$reviewed_patch" ]
}
zero=0000000000000000000000000000000000000000
status=0
while read -r _ local_sha remote_ref remote_sha; do
  [ "$remote_ref" = refs/heads/main ] || continue
  [ "$local_sha" = "$zero" ] && continue
  if [ "$local_sha" != "$reviewed" ] && same_patch; then
    continue
  elif [ "$local_sha" != "$reviewed" ]; then
    echo "pre-push: ${local_sha:0:7} hasn't been through /review-loop, which this repository runs before every push to main." >&2
    echo "  Run /review-loop; it records the commit it finds clean. (By hand, git push --no-verify skips this.)" >&2
    status=1
  elif [ -z "$reviewed_base" ] || [ "$remote_sha" = "$zero" ] || ! git merge-base --is-ancestor "$reviewed_base" "$remote_sha" 2>/dev/null; then
    echo "pre-push: the review of ${local_sha:0:7} didn't cover every commit this push adds to main." >&2
    echo "  Fetch, then run /review-loop again, so it reviews everything main doesn't have yet." >&2
    status=1
  fi
done
exit $status
