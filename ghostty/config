# Font
font-family = MesloLGS NF
font-size = 11

# Cursor
cursor-style = block
cursor-style-blink = false

# Window
macos-titlebar-style = native
confirm-close-surface = false

# Input
macos-option-as-alt = true

# Auto-attach to tmux on launch. Wrapped in a login shell so the tmux
# server inherits the full PATH — otherwise run-shell hooks and popup
# scripts can't find tmux/brew binaries.
command = /bin/zsh -l -c '/opt/homebrew/bin/tmux new-session -A -s main'

# Disable close keybindings
keybind = super+w=unbind
keybind = super+shift+w=unbind
keybind = super+q=unbind

# Cmd-S, Cmd-Z, Cmd-Shift-Z and Cmd-X as Ctrl+Alt+Shift keys (CSI u), which
# tmux passes only to the notes app, where the easy_keys setting makes them
# save, undo, redo and cut (tmux.conf, "Cmd keys for Notes' easy mode"); tmux
# would read a Cmd key as Alt. Cmd-C and Cmd-V stay Ghostty's own.
keybind = super+s=csi:115;8u
keybind = super+z=csi:122;8u
keybind = super+shift+z=csi:121;8u
keybind = super+x=csi:120;8u

# Allow Cmd+Click to open links even inside tmux
mouse-shift-capture = false

# Theme override — written by tmux/theme.sh; optional so missing file is fine
config-file = ?~/.config/ghostty/theme-mode.conf

# The user layer: your own Ghostty settings, read last so they win, and never
# in this repository, so updates leave them be.
config-file = ?~/.config/switchboard/ghostty
